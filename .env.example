# Required: amoCRM account and source stage
AMO_BASE_URL=https://studioanixaipro.amocrm.ru
AMO_ACCESS_TOKEN=
AMO_PIPELINE_ID=
AMO_SOURCE_STATUS_ID=

# Optional: where to move successfully processed source deals
AMO_SUCCESS_STATUS_ID=

# enrich = attach contacts to the current deal; new_lead = create a fresh deal per contact
AMO_WRITE_MODE=enrich
AMO_OUTPUT_PIPELINE_ID=
AMO_OUTPUT_STATUS_ID=

# Optional amoCRM custom field IDs. Run `npm run inspect:amo` to discover them.
AMO_COMPANY_WEBSITE_FIELD_ID=
AMO_COMPANY_NAME_FIELD_ID=
AMO_CONTACT_POSITION_FIELD_ID=

# Safety and batch controls
CONTACT_SEARCH_OPERATION=research
CONTACT_SEARCH_MODE=dry-run
MANUAL_COMPANY_NAME=
MANUAL_COMPANY_WEBSITE=
MAX_COMPANIES=10
MAX_CONTACTS_PER_COMPANY=5
MAX_PAGES_PER_SITE=8
MIN_CONTACT_SCORE=35
INCLUDE_GENERIC_EMAILS=true
CREATE_FOLLOW_UP_TASK=true
FOLLOW_UP_DAYS=2

# Search roles, separated by `|`
TARGET_ROLES=собственник|основатель|генеральный директор|директор по маркетингу|бренд-менеджер|директор по персоналу|обучение и развитие|внутренние коммуникации|охрана труда|промышленная безопасность

# Optional providers. The website crawler works without these keys.
TAVILY_API_KEY=
HUNTER_API_KEY=
HUNTER_VERIFY_EMAILS=false
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SEARXNG_INSTANCES=https://searx.be,https://search.bus-hit.me,https://priv.au
GITHUB_OSINT_TOKEN=
YOUTUBE_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Daily demand radar. The built-in catalog is rotated inside this daily budget.
DEMAND_QUERY_BUDGET=36
DEMAND_MAX_SIGNALS=120
DEMAND_FEEDS=

# Optional review dashboard persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Networking
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2
USER_AGENT=AnixContactResearchBot/0.1 (+https://studio.anix-ai.pro)
