{
  "name": "anix-data-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Weekly cloud contact discovery and amoCRM enrichment for Anix",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "inspect:amo": "tsx src/inspect-amo.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.2",
    "openai": "^5.19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
